        <RoundRectangle x="382" y="147" width="14" height="9" cornerRadiusX="3" cornerRadiusY="3"><Fill color="#FF2D46"/></RoundRectangle>
      </PartDraw>
      <PartText name="hr_text" x="0" y="0" width="480" height="480">
        <TextCircular centerX="240" centerY="240" width="336" height="336" startAngle="112" endAngle="62" direction="COUNTER_CLOCKWISE" align="CENTER">
          <Font family="space_mono_bold" size="17" color="#FF2D46">
            <Template>%d BPM<Parameter expression="[HEART_RATE]"/></Template>
          </Font>
        </TextCircular>
      </PartText>
    </Group>
