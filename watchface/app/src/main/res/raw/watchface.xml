<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="480" height="480">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:10:00"/>
  <Scene backgroundColor="#FF000000">
    <Group name="ticks" x="0" y="0" width="480" height="480">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartDraw name="ticks_gray" x="0" y="0" width="480" height="480">
        <Arc centerX="240" centerY="240" width="448" height="448" startAngle="-0.384" endAngle="359.616" direction="CLOCKWISE">
          <Stroke color="#4A4A4A" thickness="13" cap="BUTT" dashIntervals="3 20.457"/>
        </Arc>
      </PartDraw>
      <PartDraw name="ticks_orange" x="0" y="0" width="480" height="480">
        <Arc centerX="240" centerY="240" width="448" height="448" startAngle="-0.384" endAngle="359.616" direction="CLOCKWISE">
          <Transform target="endAngle" value="-0.384 + [SECOND]*6 + 2"/>
          <Stroke color="#FF7A1A" thickness="13" cap="BUTT" dashIntervals="3 20.457"/>
        </Arc>
      </PartDraw>
      <Group name="sec_marker" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
        <Transform target="angle" value="[SECOND]*6"/>
        <PartDraw x="0" y="0" width="480" height="480">
          <RoundRectangle x="237" y="4" width="6" height="26" cornerRadiusX="3" cornerRadiusY="3">
            <Fill color="#FFFFFF"/>
          </RoundRectangle>
        </PartDraw>
      </Group>
      <PartDraw name="dot9" x="0" y="0" width="480" height="480">
        <Ellipse x="5" y="232" width="16" height="16">
          <Fill color="#FF7A1A"/>
        </Ellipse>
      </PartDraw>
    </Group>
    <Group name="battery" x="0" y="0" width="480" height="480">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartDraw name="batt_track" x="0" y="0" width="480" height="480">
        <Arc centerX="240" centerY="240" width="400" height="400" startAngle="-45" endAngle="45" direction="CLOCKWISE">
          <Stroke color="#06362A" thickness="12" cap="ROUND"/>
        </Arc>
      </PartDraw>
      <PartDraw name="batt_fill" x="0" y="0" width="480" height="480">
        <Arc centerX="240" centerY="240" width="400" height="400" startAngle="-45" endAngle="45" direction="CLOCKWISE">
          <Transform target="endAngle" value="-45 + 90*[BATTERY_PERCENT]/100"/>
          <Stroke color="#00F5A0" thickness="12" cap="ROUND"/>
        </Arc>
      </PartDraw>
      <Group name="shimmer" x="0" y="0" width="480" height="480">
        <Transform target="alpha" value="clamp([BATTERY_CHARGING_STATUS]*255,0,255)"/>
        <PartDraw name="shimmer_arc" x="0" y="0" width="480" height="480">
          <Arc centerX="240" centerY="240" width="400" height="400" startAngle="0" endAngle="14" direction="CLOCKWISE">
            <Transform target="startAngle" value="-45 + fract([SECOND_MILLISECOND]/2500)*clamp(90*[BATTERY_PERCENT]/100-14,0,90)"/>
            <Transform target="endAngle" value="-45 + fract([SECOND_MILLISECOND]/2500)*clamp(90*[BATTERY_PERCENT]/100-14,0,90) + 14"/>
            <Stroke color="#C9FFE9" thickness="12" cap="ROUND"/>
          </Arc>
        </PartDraw>
      </Group>
      <PartDraw name="bolt_bg" x="0" y="0" width="480" height="480">
        <Ellipse x="216" y="13" width="48" height="48">
          <Fill color="#1B1B1B"/>
        </Ellipse>
      </PartDraw>
      <PartDraw name="bolt_ring" x="0" y="0" width="480" height="480">
        <Ellipse x="216" y="13" width="48" height="48">
          <Stroke color="#555555" thickness="2"/>
        </Ellipse>
      </PartDraw>
      <PartImage name="bolt" x="228" y="21" width="24" height="32">
        <Image resource="bolt"/>
      </PartImage>
      <PartText name="batt_pct" x="140" y="62" width="200" height="30">
        <Text align="CENTER">
          <Font family="space_mono_bold" size="22" color="#00F5A0">
            <Template>%d%%<Parameter expression="[BATTERY_PERCENT]"/></Template>
          </Font>
        </Text>
      </PartText>
      <PartText name="batt_state_on" x="140" y="90" width="200" height="20">
        <Transform target="alpha" value="clamp([BATTERY_CHARGING_STATUS]*255,0,255)"/>
        <Text align="CENTER">
          <Font family="space_mono_bold" size="13" color="#00F5A0" letterSpacing="1">
            CHARGING
          </Font>
        </Text>
      </PartText>
      <PartText name="batt_state_off" x="140" y="90" width="200" height="20">
        <Transform target="alpha" value="255-clamp([BATTERY_CHARGING_STATUS]*255,0,255)"/>
        <Text align="CENTER">
          <Font family="space_mono_bold" size="13" color="#7FD9B8" letterSpacing="1">
            BATTERY
          </Font>
        </Text>
      </PartText>
    </Group>
    <Group name="heart" x="0" y="0" width="480" height="480">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartDraw name="hr_track" x="0" y="0" width="480" height="480">
        <Arc centerX="240" centerY="240" width="410" height="410" startAngle="22" endAngle="152" direction="CLOCKWISE">
